# Harness Remote Hub configuration. Copy to `.env` (or run `sh deploy/init-env.sh`, which fills the
# secrets in for you). `.env` holds real passwords: it is git-ignored, keep it that way.

# ---- required secrets ---------------------------------------------------------------------------------
# Use only letters and digits in POSTGRES_PASSWORD: it is embedded in a connection URL.
POSTGRES_PASSWORD=
# The one password for the hub console (12+ characters).
HUB_ADMIN_PASSWORD=
# 32+ characters. Derives the key that encrypts the gateway credentials machines share, and signs the
# session cookie. Changing it signs everyone out and makes stored credentials unreadable until each
# machine re-sends them (they do, on their next start).
HUB_SECRET_KEY=

# ---- how machines join ----------------------------------------------------------------------------------
# Optional shared token any new install can use to enroll (16+ characters). Anything can also be enrolled
# with a per-machine token created in the console's "Add machine" page, which is the better habit.
HUB_ENROLLMENT_TOKEN=

# ---- reaching the hub -----------------------------------------------------------------------------------
# 127.0.0.1 = this computer only. 0.0.0.0 = your network. The console is plain HTTP unless you use the
# `tls` profile or your own reverse proxy: read "HTTPS for iPhone" in docs/HUB.md before exposing it.
HUB_BIND=127.0.0.1
HUB_PORT=8080
# The address people and machines use to reach the hub, e.g. https://hub.example.com. Shown in install
# commands. Leave empty to use whatever address the browser used.
HUB_PUBLIC_URL=
# Set to 1 ONLY behind a reverse proxy you control (Caddy, nginx, Traefik, Tailscale serve): it makes
# the hub believe X-Forwarded-Proto/-For, which anyone can forge if they can reach the hub directly.
HUB_TRUST_PROXY=0
HUB_NAME=Harness Remote Hub
# What the console tells people to run on a machine.
HUB_INSTALL_COMMAND=npx --yes github:enslaver/harness-remote-plus

# ---- optional: HTTPS with Caddy (docker compose --profile tls up -d) ---------------------------------------
# HUB_DOMAIN=hub.example.com

# ---- optional: Grafana over the logs (docker compose --profile grafana up -d) -------------------------------
# GRAFANA_ADMIN_PASSWORD=          # defaults to HUB_ADMIN_PASSWORD
# GRAFANA_BIND=127.0.0.1
# GRAFANA_PORT=3000
